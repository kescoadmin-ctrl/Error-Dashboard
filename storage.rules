rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Coordinators can read/write their own user data
    match /{userId}/snapshots/{allPaths=**} {
      allow read, write: if 
        request.auth.uid == userId &&
        get(/databases/(default)/documents/users/$(userId)).data.role == 'coordinator';
    }

    // Administrators can only read coordinator data
    match /{userId}/snapshots/{allPaths=**} {
      allow read: if 
        request.auth.uid != userId &&
        get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'administrator';
    }

    // No other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
